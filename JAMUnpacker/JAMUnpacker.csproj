<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>JAMUnpacker</RootNamespace>
    <AssemblyName>JAMUnpacker</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <Product>JAMUnpacker</Product>
    <Description>Unpacks JAM files used by The Grim Adventures of Billy and Mandy game.</Description>
    <Company>Hunter Stanton</Company>
    <Authors>Hunter Stanton</Authors>
    <Copyright>Copyright © Hunter Stanton 2026</Copyright>
    <Version>1.0.0</Version>

    <!-- No culture-specific behaviour is needed; avoids a libicu dependency on Linux. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Settings applied when publishing for a specific runtime (dotnet publish -r <rid>). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
